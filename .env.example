# Dev-only placeholder values. Copy to .env; never commit .env or real secrets.
POSTGRES_DB=tracex
POSTGRES_USER=tracex
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_PORT=5432

NEO4J_USER=neo4j
NEO4J_PASSWORD=dev-only-neo4j-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

API_PORT=8000

# development, local, test or demo. The demo seed runs only for exactly one of these four values;
# anything else, or no value, makes it refuse.
TRACEX_ENV=development

# The API refuses to start on the dev-only values below unless this is exactly 1. The demo seed also
# needs it to be 1 (second check). Set it only for local development and CI; never in a shared or
# real deployment.
TRACEX_ALLOW_DEV_SECRETS=1

# API keys: four distinct base64url values of at least 32 bytes. The values below are dev-only
# placeholders so `docker compose up` works from a copy of this file. For any shared or real
# deployment generate your own: python -c "import secrets;print(secrets.token_urlsafe(32))"
TRACEX_JWT_KEY=ZGV2LW9ubHktdHJhY2V4LWp3dC1rZXktMDAwMDAwMDA=
TRACEX_CURSOR_KEY=ZGV2LW9ubHktdHJhY2V4LWN1cnNvci1rZXktMDAwMDA=
TRACEX_ROW_REF_KEY=ZGV2LW9ubHktdHJhY2V4LXJvd3JlZi1rZXktMDAwMDA=
TRACEX_HMAC_KEY=ZGV2LW9ubHktdHJhY2V4LWhtYWMta2V5LTAwMDAwMDA=
# The audit anchor is appended to this file, outside the database.
AUDIT_ANCHOR_PATH=/var/lib/tracex/audit-anchor.log
# Database logins: the API connects as tracex_api; migrations and the seed use DATABASE_ADMIN_URL.
TRACEX_API_DB_PASSWORD=dev-only-api-db-password
TRACEX_MIGRATOR_DB_PASSWORD=dev-only-migrator-db-password
# Only the test suite reads this: a disposable Postgres server with a superuser, for API tests.
TRACEX_TEST_PG_URL=

# Seed-user passwords: dev-only placeholders for the synthetic demo users. Never reuse real ones.
TRACEX_SEED_PASSWORD_ASHA=dev-only-seed-asha
TRACEX_SEED_PASSWORD_ISHA=dev-only-seed-isha
TRACEX_SEED_PASSWORD_JATIN=dev-only-seed-jatin
TRACEX_SEED_PASSWORD_KIRAN=dev-only-seed-kiran
TRACEX_SEED_PASSWORD_OMKAR=dev-only-seed-omkar
TRACEX_SEED_PASSWORD_BHARAT=dev-only-seed-bharat
TRACEX_SEED_PASSWORD_ESHA=dev-only-seed-esha
TRACEX_SEED_PASSWORD_GITA=dev-only-seed-gita
TRACEX_SEED_PASSWORD_CHARU=dev-only-seed-charu
TRACEX_SEED_PASSWORD_FARID=dev-only-seed-farid
TRACEX_SEED_PASSWORD_LATA=dev-only-seed-lata
TRACEX_SEED_PASSWORD_DEEPAK=dev-only-seed-deepak
TRACEX_SEED_PASSWORD_MEENA=dev-only-seed-meena
TRACEX_SEED_PASSWORD_HARI=dev-only-seed-hari
