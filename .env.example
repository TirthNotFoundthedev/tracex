# Dev-only placeholder values. Copy to .env; never commit .env or real secrets.
POSTGRES_DB=tracex
POSTGRES_USER=tracex
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_PORT=5432

NEO4J_USER=neo4j
NEO4J_PASSWORD=dev-only-neo4j-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

API_PORT=8000

# API secrets: four distinct base64url values of at least 32 random bytes each, for example
# python -c "import secrets;print(secrets.token_urlsafe(32))". Generate your own; never commit them.
TRACEX_JWT_KEY=
TRACEX_CURSOR_KEY=
TRACEX_ROW_REF_KEY=
TRACEX_HMAC_KEY=
# The audit anchor is appended to this file, outside the database.
AUDIT_ANCHOR_PATH=/var/lib/tracex/audit-anchor.log
# Database logins: the API connects as tracex_api; migrations and the seed use DATABASE_ADMIN_URL.
TRACEX_API_DB_PASSWORD=
TRACEX_MIGRATOR_DB_PASSWORD=
# Only the test suite reads this: a disposable Postgres server with a superuser, for API tests.
TRACEX_TEST_PG_URL=

# Seed-user passwords for local demo only. Set them locally in .env; never commit real values.
TRACEX_SEED_PASSWORD_ASHA=
TRACEX_SEED_PASSWORD_ISHA=
TRACEX_SEED_PASSWORD_JATIN=
TRACEX_SEED_PASSWORD_KIRAN=
TRACEX_SEED_PASSWORD_OMKAR=
TRACEX_SEED_PASSWORD_BHARAT=
TRACEX_SEED_PASSWORD_ESHA=
TRACEX_SEED_PASSWORD_GITA=
TRACEX_SEED_PASSWORD_CHARU=
TRACEX_SEED_PASSWORD_FARID=
TRACEX_SEED_PASSWORD_LATA=
TRACEX_SEED_PASSWORD_DEEPAK=
TRACEX_SEED_PASSWORD_MEENA=
TRACEX_SEED_PASSWORD_HARI=
